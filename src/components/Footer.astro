---
import siteData from '../content/site.json';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-note">
    Not affiliated with any government agency. For informational purposes only.
  </div>
  <div class="footer-grid">
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/">Readiness</a>
      <a href="/forecast/">Forecast</a>
      <a href="/disaster-resources/">Disaster Resources</a>
    </nav>
    <div class="footer-attribution">
      A <strong class="helpful-neighbor"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i> Helpful Neighbor</strong> project — <span class="built-by">built by</span> <a href={siteData.meta.authorUrl} target="_blank" rel="noopener">{siteData.meta.authorName}</a>
    </div>
    <div class="footer-license">
      &copy; {year} ARwx.info &middot; Licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>
    </div>
    <div class="footer-links">
      <a href={siteData.meta.suggestionsUrl} target="_blank" rel="noopener"><i class="fa-solid fa-message" aria-hidden="true"></i> Feedback</a>
      <a href={siteData.meta.kofiUrl} target="_blank" rel="noopener"><i class="fa-solid fa-mug-hot" aria-hidden="true"></i> Support on Ko-fi</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-2xl) 0;
    margin-top: var(--space-xl);
  }

  .footer-note {
    max-width: var(--max-width);
    margin: 0 auto var(--space-md);
    padding: 0 var(--space-lg) var(--space-md);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .footer-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: var(--space-sm) var(--space-lg);
    align-items: baseline;
  }

  .footer-nav {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    gap: var(--space-md);
  }

  .footer-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .footer-attribution {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer-attribution a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .footer-attribution a:hover {
    color: var(--color-text);
  }

  .built-by {
    font-style: italic;
    color: var(--color-text-muted);
  }

  .helpful-neighbor {
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .helpful-neighbor i {
    color: var(--color-accent);
    margin-right: 3px;
    font-size: 0.75rem;
  }

  .footer-license {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .footer-license a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-license a:hover {
    text-decoration: underline;
  }

  .footer-links {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    gap: var(--space-md);
    align-items: center;
    font-size: 0.75rem;
    justify-content: flex-end;
    text-align: right;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a i {
    margin-right: 0.3em;
    opacity: 0.7;
  }

  .footer-links a:hover {
    color: var(--color-text-secondary);
  }

  .footer-links a:hover i {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-attribution,
    .footer-links {
      grid-column: 1;
      text-align: center;
      justify-content: center;
    }

    .footer-attribution { grid-row: 2; }
    .footer-license { grid-row: 3; }
    .footer-links { grid-row: 4; }
  }
</style>
