---
interface Props {
  id?: string;
  heading?: string;
  description?: string;
}

const { id, heading, description } = Astro.props;
---

<section id={id} class="content-section">
  {heading && <h2>{heading}</h2>}
  {description && <p class="section-description">{description}</p>}
  <slot />
</section>

<style>
  .content-section {
    margin-bottom: var(--space-3xl);
  }

  .content-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
  }

  .content-section :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
  }

  .section-description,
  .content-section :global(.section-description) {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }
</style>
