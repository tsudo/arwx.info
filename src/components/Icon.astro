---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 24 } = Astro.props;

const faIcons: Record<string, string> = {
  'x-twitter': 'fa-brands fa-x-twitter',
  'radio': 'fa-solid fa-radio',
  'bell': 'fa-solid fa-bell',
  'radar': 'fa-solid fa-location-crosshairs',
  'shield': 'fa-solid fa-shield-halved',
  'arrow-up-right': 'fa-solid fa-up-right-from-square',
  'house': 'fa-solid fa-house',
  'box': 'fa-solid fa-box',
  'phone': 'fa-solid fa-phone',
  'map-pin': 'fa-solid fa-location-dot',
  'alert': 'fa-solid fa-triangle-exclamation',
  'book': 'fa-solid fa-book',
  'users': 'fa-solid fa-users',
  'heart-handshake': 'fa-solid fa-hand-holding-heart',
  'wrench': 'fa-solid fa-wrench',
  'smartphone': 'fa-solid fa-mobile-screen',
  'cloud-lightning': 'fa-solid fa-cloud-bolt',
  'eye': 'fa-solid fa-eye',
  'eye-off': 'fa-solid fa-eye-slash',
  'clipboard': 'fa-solid fa-clipboard',
  'share': 'fa-solid fa-share-nodes',
  'megaphone': 'fa-solid fa-bullhorn',
  'message-circle': 'fa-solid fa-comment',
  'zap': 'fa-solid fa-bolt',
  'backpack': 'fa-solid fa-suitcase',
  'hard-hat': 'fa-solid fa-helmet-safety',
  'footprints': 'fa-solid fa-shoe-prints',
  'volume-2': 'fa-solid fa-volume-high',
  'sparkles': 'fa-solid fa-wand-magic-sparkles',
};

const faClass = faIcons[name] || 'fa-solid fa-circle-question';
---

<i class:list={[faClass, 'icon']} style={`font-size: ${size}px`} aria-hidden="true"></i>
