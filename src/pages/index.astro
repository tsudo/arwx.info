---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import LinkList from '../components/LinkList.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import WeatherCard from '../components/WeatherCard.astro';
import siteData from '../content/site.json';

const page = siteData.pages.home;
---

<BaseLayout title={page.title} description={page.description}>
  <div class="hero">
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.subheading}</p>
    <h2 class="quick-links-heading">Quick Links</h2>
    <div class="quick-links">
      {page.quickLinks.map((link) => (
        <a href={link.url} class="quick-link" rel="noopener noreferrer" target="_blank">
          <Icon name={link.icon} size={18} />
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <WeatherCard />

  <Section id="essentials" heading="The Essentials">
    <div class="card-grid">
      {page.essentials.map((item) => (
        <Card
          icon={item.icon}
          title={item.title}
          description={item.description}
          bullets={item.bullets}
          links={item.links}
        />
      ))}
    </div>
  </Section>

  <Section id="alerts">
    <div class="section-heading-with-icon">
      <Icon name="bell" size={22} />
      <h2>{page.alertsAndApps.heading}</h2>
    </div>
    <p class="section-description">{page.alertsAndApps.description}</p>
    <Callout variant="warning">
      <p><Icon name="eye-off" size={16} /> <strong>Privacy note:</strong> {page.alertsAndApps.privacyNote}</p>
    </Callout>
    <LinkList links={page.alertsAndApps.links} />
  </Section>

  <Section id="official-weather">
    <div class="section-heading-with-icon">
      <Icon name="cloud-lightning" size={22} />
      <h2>{page.officialWeather.heading}</h2>
    </div>
    <p class="section-description">{page.officialWeather.description}</p>
    <LinkList links={page.officialWeather.links} />
  </Section>

  <Section
    id="official"
    heading={page.officialSources.heading}
    description={page.officialSources.description}
  >
    <LinkList links={page.officialSources.links} />
  </Section>

  <Section id="prep">
    <div class="section-heading-with-icon">
      <Icon name="shield" size={22} />
      <h2>{page.prep101.heading}</h2>
    </div>
    {page.prep101.sections.map((section) => (
      <div class="prep-block">
        <h3 class="prep-heading">
          {section.icon && <Icon name={section.icon} size={18} />}
          {section.title}
        </h3>
        <ul>
          {section.items.map((item) => <li>{item}</li>)}
        </ul>
        {section.links && section.links.length > 0 && (
          <div class="prep-links">
            {section.links.map((link) => (
              <a href={link.url} rel="noopener noreferrer" target="_blank">
                {link.label} <Icon name="arrow-up-right" size={14} />
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </Section>

  <Section id="meteorologists">
    <div class="section-heading-with-icon">
      <Icon name="x-twitter" size={22} />
      <h2>{page.meteorologists.heading}</h2>
    </div>
    <p class="section-description">{page.meteorologists.description}</p>
    <a href={page.meteorologists.listUrl} class="list-link" rel="noopener noreferrer" target="_blank">
      <Icon name="arrow-up-right" size={16} />
      {page.meteorologists.listLabel}
    </a>
  </Section>

  <Callout variant="info">
    <p><strong>Watch vs. Warning:</strong> A <em>Watch</em> means conditions are favorable for severe weather — stay alert. A <em>Warning</em> means severe weather is occurring or imminent — take shelter immediately.</p>
  </Callout>

  <div class="share-section">
    <p class="share-label">Help others stay prepared — share this page</p>
    <div class="share-buttons">
      <a
        href="https://twitter.com/intent/tweet?text=Arkansas%20severe%20weather%20readiness%20resources&url=https%3A%2F%2Farwx.info&via=arwx"
        class="share-btn share-btn-x"
        rel="noopener noreferrer"
        target="_blank"
      >
        <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
        Share on X
      </a>
      <a
        href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farwx.info"
        class="share-btn share-btn-fb"
        rel="noopener noreferrer"
        target="_blank"
      >
        <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
        Share on Facebook
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* ─── Quick Links ─── */
  .quick-links-heading {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-top: var(--space-xl);
    margin-bottom: 0;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .quick-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    border: 1px solid var(--color-info-border);
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }

  .quick-link:hover {
    background: var(--color-bg);
    border-color: var(--color-accent);
  }

  .quick-link :global(.icon) {
    flex-shrink: 0;
  }

  /* ─── Card Grid ─── */
  .card-grid {
    display: grid;
    gap: var(--space-lg);
  }

  /* ─── Prep Blocks ─── */
  .prep-block {
    margin-bottom: var(--space-xl);
  }

  .prep-block h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .prep-heading {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .prep-heading :global(.icon) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .prep-links {
    margin-top: var(--space-sm);
    padding-left: var(--space-lg);
  }

  .prep-links a {
    color: var(--color-link);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .prep-links a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .prep-block ul {
    list-style: none;
  }

  .prep-block li {
    padding: var(--space-xs) 0;
    padding-left: var(--space-lg);
    position: relative;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  .prep-block li::before {
    content: '\2014';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  /* ─── List Link ─── */
  .list-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-link);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.15s, background 0.15s;
  }

  .list-link:hover {
    border-color: var(--color-link);
    background: var(--color-accent-light);
    text-decoration: none;
  }

  /* ─── Share Section ─── */
  .share-section {
    text-align: center;
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }

  .share-label {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .share-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    transition: opacity 0.15s;
  }

  .share-btn:hover {
    opacity: 0.85;
  }

  .share-btn-x {
    background: #000;
    color: #fff;
  }

  .share-btn-fb {
    background: #1877f2;
    color: #fff;
  }

  @media (prefers-color-scheme: dark) {
    .share-btn-x {
      background: #e7e9ea;
      color: #14171a;
    }
  }
</style>
